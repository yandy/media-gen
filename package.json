{
  "name": "@yandy0725/mediagen-cli",
  "version": "0.2.0",
  "description": "Non-interactive image generation and editing, plus short video generation, for agents: qwen-image, doubao/seedream, doubao/seedance, MiniMax H3, files on disk, JSON output.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mediagen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "cli",
    "image",
    "image-generation",
    "image-editing",
    "video",
    "video-generation",
    "text-to-video",
    "seedance",
    "minimax",
    "text-to-image",
    "qwen",
    "dashscope",
    "seedream",
    "doubao",
    "ark",
    "agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node18 --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yandy/mediagen-cli.git"
  },
  "bugs": {
    "url": "https://github.com/yandy/mediagen-cli/issues"
  },
  "homepage": "https://github.com/yandy/mediagen-cli#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
